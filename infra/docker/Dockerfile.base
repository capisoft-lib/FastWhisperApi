# Base image for capitaine/fast-whisper-api
# Linux image: PyTorch 2.6, CUDA 12.4 with all dependencies pre-installed
FROM pytorch/pytorch:2.6.0-cuda12.4-cudnn9-devel

LABEL maintainer="capitaine"
LABEL description="Base image for FastWhisper API - faster-whisper speech-to-text transcription with CUDA support"
LABEL version="1.0.0"

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# System deps: ffmpeg for loading audio (mp3, etc.), build-essential/ninja for flash-attn if enabled
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    build-essential \
    ninja-build \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# API deps (torch already in base image)
COPY infra/docker/requirements-docker.txt .
RUN pip install --no-cache-dir -r requirements-docker.txt

# Install faster-whisper
RUN pip install --no-cache-dir faster-whisper

# Flash Attention 2: Optional for performance boost
# Uncomment below to include flash-attn (increases build time significantly)
# RUN pip install --no-cache-dir flash-attn --no-build-isolation

# Hugging Face cache: use a single dir so a volume can persist the model
ENV HF_HOME=/data/cache

# Create cache directory
RUN mkdir -p /data/cache

EXPOSE 8000

# Default CMD can be overridden by derived images
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
